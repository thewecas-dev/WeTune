<?xml version="1.0" encoding="utf-8"?>
<!-- The system launch screen shows no mark: just the plain page colour (splash_bg). The real splash (the app's top wash, Cue tile,
     animated mark) is drawn by the app's first frame, ui/Splash.kt, on exactly this colour, so the hand-off is seamless. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size android:width="1dp" android:height="1dp" />
</shape>
