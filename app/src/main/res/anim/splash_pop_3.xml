<?xml version="1.0" encoding="utf-8"?>
<!-- A part of the launch mark popping in from nothing with a small overshoot (starts after 420 ms). -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
    <objectAnimator android:propertyName="scaleX" android:valueFrom="0" android:valueTo="1" android:startOffset="420"
        android:duration="380" android:interpolator="@android:interpolator/overshoot" />
    <objectAnimator android:propertyName="scaleY" android:valueFrom="0" android:valueTo="1" android:startOffset="420"
        android:duration="380" android:interpolator="@android:interpolator/overshoot" />
</set>
